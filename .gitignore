# ===================================================================
# Python Universal
#
# Common patterns for Python projects to ignore compiled files,
# caches, and virtual environments.
# ===================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
venv/
env/

# ===================================================================
# Secrets & Credentials
#
# NEVER commit your API keys or environment variables.
# The .env file is specifically used by the Telegram scripts.
# The session files are created on login and are not needed in the repo.
# ===================================================================
*.env
.env
.env.*
*.session

# ===================================================================
# Script-Specific Output & Caches
#
# These are files and folders generated by your scripts during operation.
# ===================================================================

# Advaita (Local)
# Folder for moved duplicate files.
duplicates/

# Adwaita (Telegram)
# Cache file to resume scans and temporary files for hashing.
progress_cache.json
*.tmp

# Telegram Group Downloader
# Default output folder for downloaded media. The wildcard handles any group name.
*_media/

# Mega Tor Downloader
# Default folder for log files.
mega-tor-logs/

# Universal Log Files
*.log

# ===================================================================
# Operating System Generated Files
#
# Common junk files created by macOS, Windows, and Linux.
# ===================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db